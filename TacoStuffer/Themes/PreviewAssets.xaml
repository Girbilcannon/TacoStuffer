<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Shared, frozen preview assets. They do not add attributes or files to a pack. -->
    <DrawingImage x:Key="DefaultMarkerPreview" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#DC232833" Geometry="M 12,1 L 23,12 L 12,23 L 1,12 Z">
                    <GeometryDrawing.Pen><Pen Brush="#FFE023FF" Thickness="2"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFE023FF" Geometry="M 12,6 L 18,12 L 12,18 L 6,12 Z"/>
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="M 12,10 L 14,12 L 12,14 L 10,12 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Prepared for the future trail preview: repeated directional chevrons. -->
    <DrawingBrush x:Key="DefaultTrailPreview" po:Freeze="True" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,32,32" ViewboxUnits="Absolute" Viewbox="0,0,32,32" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#70394730" Geometry="M 0,0 L 32,0 L 32,32 L 0,32 Z"/>
                <GeometryDrawing Brush="#FF9FC98E" Geometry="M 3,11 L 16,2 L 29,11 L 29,18 L 16,9 L 3,18 Z"/>
                <GeometryDrawing Brush="#FF9FC98E" Geometry="M 3,26 L 16,17 L 29,26 L 29,32 L 16,24 L 3,32 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
