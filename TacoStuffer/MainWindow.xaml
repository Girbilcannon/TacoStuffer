<Window x:Class="TacoStuffer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:TacoStuffer.Views" Title="Taco Stuffer — 0.1.1b Open Beta" Background="{StaticResource BackgroundBrush}" Foreground="#E6EBF3" WindowStyle="None" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Width="1500" Height="940" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen">
<Window.Resources><ControlTemplate x:Key="GamePaneTemplate" TargetType="TabControl"><Grid Background="#111920"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid></ControlTemplate></Window.Resources>
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{StaticResource BackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#10141A" Padding="16,10" MouseLeftButtonDown="HeaderDrag"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="GameConnectionDot" Text="●" Foreground="#DAAE6D" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="GameConnectionText" Text="GW2 disconnected" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="OverlayButton" Content="Open Game Overlay" IsEnabled="False" ToolTip="Requires fresh GW2 map telemetry. Create or open a project and add an XML document before recording." ToolTipService.ShowOnDisabled="True" Margin="18,0,12,0" Click="ShowOverlay"/><Button Content="—" Padding="10,6" Click="MinimizeWindow"/><Button Content="□" Padding="10,6" Click="MaximizeWindow"/><Button Content="×" Padding="10,6" Click="CloseWindow"/></StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel><TextBlock Text="TACO STUFFER" FontWeight="Bold" FontSize="18"/><TextBlock Text="by: Girbilcannon.8259" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel><TextBlock Text=" / " Foreground="#586475" FontSize="18" Margin="10,0" VerticalAlignment="Center"/><TextBlock x:Name="ProjectTitle" Text="" FontSize="18" VerticalAlignment="Center"/></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,4"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Stuff Taco Now!" Background="{StaticResource TortillaBrush}" Foreground="#292118" FontWeight="Bold" Padding="18,6" VerticalAlignment="Center" Click="BuildPreview"/>
   <Menu VerticalAlignment="Center"><MenuItem Header="Project" Padding="12,5"><MenuItem Header="New…" InputGestureText="Ctrl+N" Click="NewProject"/><MenuItem Header="New Document"><MenuItem Header="XML" Click="NewXmlDocument"/><MenuItem Header="LUA" Click="NewLuaDocument"/><MenuItem Header="Markdown" Click="NewMarkdownDocument"/><MenuItem Header="Plain Text (.txt)" Click="NewTextDocument"/></MenuItem><MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="OpenProject"/><MenuItem Header="Save" InputGestureText="Ctrl+S" Click="SaveProject"/><Separator/><MenuItem Header="Import .taco File…" Click="ImportTaco"/><Separator/><MenuItem Header="Import Textures/Icons…" Click="ImportTextures"/></MenuItem><MenuItem Header="Edit" Padding="12,5"><MenuItem x:Name="UndoMenuItem" Header="Undo" InputGestureText="Ctrl+Z" Click="UndoProject" IsEnabled="False"/><MenuItem x:Name="RedoMenuItem" Header="Redo" InputGestureText="Ctrl+Shift+Z" Click="RedoProject" IsEnabled="False"/><MenuItem Header="History…" Click="ShowHistory"/><Separator/><MenuItem Header="Preferences…" Click="ShowPreferences"/><MenuItem Header="Project Settings…" Click="ShowProjectSettings"/></MenuItem><MenuItem Header="View" Padding="12,5"><MenuItem x:Name="OverlayMenuItem" Header="Standalone Overlay" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="ShowOverlay"/><MenuItem Header="Play in App (experimental)" Click="ShowGameTab"/><MenuItem x:Name="StandardLayoutMenuItem" Header="Standard Layout" Click="ShowStandardLayout" IsEnabled="False" ToolTip="Return to XML tabs after the hosted game has closed."/><Separator/><MenuItem Header="Reset Layout" Click="ResetLayout"/></MenuItem></Menu>
  </DockPanel></Border>
  <Grid Grid.Row="2" Margin="14,14,14,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="320" MinWidth="200"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="RightColumn" Width="380" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="14"><TextBlock Text="PROJECT EXPLORER" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><TextBox x:Name="SearchBox" ToolTip="Search names, categories, files, attributes and point IDs · Ctrl+F" TextChanged="SearchChanged" PreviewKeyDown="SearchKeyDown"/><TextBlock x:Name="SearchStatus" Text="Search elements or categories · Ctrl+F" FontSize="11" Opacity="0.6" Margin="0,4,0,0"/></StackPanel>
    <TabControl Margin="8,0,8,8"><TabItem Header="Elements"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="10"><Button Content="+ Category" Click="AddCategory"/><TextBlock Text="Shift / Ctrl / left-drag to select&#10;Middle-drag to reorder XMLs / elements" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel><ListBox x:Name="ElementsList" ScrollViewer.HorizontalScrollBarVisibility="Auto" AllowDrop="True" PreviewMouseDown="ElementsMiddleDown" PreviewMouseUp="ElementsMiddleUp" DragOver="ElementsOrderOver" Drop="ElementsOrderDrop" DragLeave="PanelDragLeave" SelectionMode="Extended" SelectionChanged="SelectElements" PreviewMouseRightButtonDown="ElementsRightClick" PreviewMouseLeftButtonDown="BeginSelectionDrag" PreviewMouseMove="SelectionDrag" PreviewMouseLeftButtonUp="EndSelectionDrag" PreviewKeyDown="ExplorerKeyDown"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="6,0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><views:ExplorerRowView Row="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem><TabItem Header="Quick Menu"><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="Middle-button drag&#10;Center = child; top/bottom = sibling&#10;F2 or right-click to rename." Style="{StaticResource MutedText}" Margin="12"/><TreeView x:Name="CategoryTree" SelectedItemChanged="SelectCategory" AllowDrop="True" PreviewMouseDown="CategoryDragStart" PreviewMouseUp="CategoryDragEnd" PreviewMouseMove="CategoryDragMove" DragOver="CategoryDragOver" Drop="CategoryDrop" DragLeave="PanelDragLeave" PreviewKeyDown="CategoryKeyDown"/></DockPanel></TabItem></TabControl>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#353E4B" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CompareSplitterColumn" Width="0"/><ColumnDefinition x:Name="CompareColumn" Width="0"/></Grid.ColumnDefinitions><TabControl x:Name="Documents" SelectionChanged="DocumentChanged"><TabItem x:Name="MarkersTab" Header="markers.xml"><DockPanel><Border DockPanel.Dock="Top" Background="#1C232B" Padding="12,9"><TextBlock Text="OverlayData / POIs / POI    •    Syntax-color preview" Style="{StaticResource MutedText}"/></Border><RichTextBox x:Name="MarkerEditor" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsTab="True"/></DockPanel></TabItem><TabItem x:Name="TrailsTab" Header="trails.xml"><RichTextBox x:Name="TrailEditor" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" AcceptsTab="True"/></TabItem><TabItem x:Name="GameTab" Header="Game" Visibility="Collapsed">
      <Grid Background="#111920"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="#1C232B" Padding="12,10"><StackPanel>
        <DockPanel LastChildFill="True"><Button x:Name="StandardLayoutButton" DockPanel.Dock="Right" Content="Standard Layout" Click="ShowStandardLayout" Margin="12,0,0,6" VerticalAlignment="Top"/><Button x:Name="ForceCloseGameButton" DockPanel.Dock="Right" Content="Force Close Game" Click="ForceCloseHostedGame" IsEnabled="False" Background="#C64747" Foreground="White" BorderBrush="#F07474" Margin="12,0,0,6" VerticalAlignment="Top" ToolTip="Immediately terminate this GW2 session; Taco Stuffer and the project remain open."/><WrapPanel><Button Content="Launch Windowed" Click="LaunchHostedGame" Margin="0,0,8,6"/><Button Content="Game Preferences…" Click="ShowGamePreferences" Margin="0,0,8,6"/><Button x:Name="HostedOverlayButton" Content="Open Overlay" Click="ShowOverlay" Margin="0,0,8,6"/><Button x:Name="HostedXmlButton" Content="Show Code" Click="ToggleHostedXml" Margin="0,0,0,6"/></WrapPanel></DockPanel>
        <TextBlock x:Name="GameViewportStatus" Text="Experimental · Launch GW2 in windowed mode, then click Play. Click inside the game to play." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
       </StackPanel></Border>
       <Border Grid.Row="1" BorderBrush="#353E4B" BorderThickness="1" Margin="8"><Grid x:Name="GameViewportSlot" Background="#111920"><StackPanel x:Name="GameViewportPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock Text="PLAY IN APP" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Launch GW2 here, then click Play. The launcher stays separate." TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid></Border>
      </Grid>
     </TabItem><TabItem Header="+" x:Name="AddTab" ToolTip="Add XML document"/></TabControl><GridSplitter x:Name="CompareSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#353E4B" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/><TabControl x:Name="ComparisonDocuments" Grid.Column="2" Visibility="Collapsed"/></Grid>
    <Border Grid.Row="1" Background="#202A30" Padding="12,10" Margin="0,10,0,0" CornerRadius="5"><TextBlock x:Name="EditorNotice" Text="" Foreground="#A4CABC" FontSize="12" TextWrapping="Wrap"/></Border>
   </Grid>
   <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" Background="#353E4B" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,0"><TextBlock Text="ATTRIBUTES" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><TextBlock x:Name="SelectionTitle" Text="" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CategoryPath" Text="" Style="{StaticResource MutedText}" Margin="0,8,0,14" TextWrapping="Wrap"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="18"><Button Content="+ Add Attributes" Click="AddAttributes"/><TextBlock Text="Local values override category values." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AttributesHost" Margin="18,0,18,0"/></ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <Border Grid.Row="3" Padding="20,12"><DockPanel><TextBlock DockPanel.Dock="Right" x:Name="BuildStatusText" Text="Build: loading…" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatusText" Text="Create or open a project to begin." Style="{StaticResource MutedText}"/></DockPanel></Border>
 </Grid>
</Window>
